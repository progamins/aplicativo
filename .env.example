# Copia este archivo a .env (mismo directorio que docker-compose.yml)
# Obligatorio:
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Opcional:
PORT=3000
CORS_ORIGIN=*

# ── Modo MySQL (compatibilidad con el sistema académico iestp) ──
# Descomenta y ajusta:
# DB_DRIVER=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=root
# DB_NAME=iestp
# DB_TABLE=listado_usuarios
# DB_USERNAME_COL=email
# DB_PASSWORD_COL=password
# DB_FULLNAME_COL=
# ENABLE_REGISTER=false

# Solo para el perfil MySQL de compose:
# MYSQL_ROOT_PASSWORD=root
# MYSQL_PORT=3307
