# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Seguridad
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10
CORS_ORIGIN=*

# Administradores (separados por coma): panel de aprobación + /api/admin/*
ADMIN_USERNAMES=

# Base de datos: sqlite (por defecto) o mysql (compatibilidad con iestp)
DB_DRIVER=sqlite
DB_PATH=./data/app.db

# ── Solo si DB_DRIVER=mysql ──
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=iestp
# DB_TABLE=listado_usuarios
# DB_USERNAME_COL=email
# DB_PASSWORD_COL=password
# DB_FULLNAME_COL=
# DB_REFRESH_TABLE=refresh_tokens

# Registro de usuarios (desactívalo si la BD la gestiona otro sistema)
ENABLE_REGISTER=true
